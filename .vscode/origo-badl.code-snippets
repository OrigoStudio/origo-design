{
  "Origo Entity": {
    "scope": "json",
    "prefix": "origo-entity",
    "body": [
      "{",
      "  \"id\": \"${1:entity-id}\",",
      "  \"name\": \"${2:EntityName}\",",
      "  \"implements\": [],",
      "  \"fields\": [",
      "    { \"name\": \"${3:fieldName}\", \"type\": \"${4:String}\" }",
      "  ]",
      "}",
    ],
    "description": "Origo BADL Entity boilerplate",
  },
  "Origo List-Detail Page": {
    "scope": "json",
    "prefix": "origo-list-detail",
    "body": [
      "{",
      "  \"id\": \"${1:default-list-detail}\",",
      "  \"name\": \"${2:DefaultListDetail}\",",
      "  \"views\": [",
      "    {",
      "      \"name\": \"List\",",
      "      \"type\": \"list\"",
      "    },",
      "    {",
      "      \"name\": \"Detail\",",
      "      \"type\": \"detail\"",
      "    }",
      "  ]",
      "}",
    ],
    "description": "Origo BADL List-Detail boilerplate",
  },
  "Origo Login Page": {
    "scope": "json",
    "prefix": "origo-login",
    "body": [
      "{",
      "  \"_secure_by_default\": true,",
      "  \"id\": \"${1:default-login}\",",
      "  \"name\": \"${2:DefaultLogin}\",",
      "  \"fields\": [",
      "    {",
      "      \"name\": \"username\",",
      "      \"type\": \"String\"",
      "    },",
      "    {",
      "      \"name\": \"password\",",
      "      \"type\": \"String\"",
      "    }",
      "  ]",
      "}",
    ],
    "description": "Origo BADL Login boilerplate",
  },
}
