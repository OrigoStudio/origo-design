+
+    // Expand
+    const header = root.querySelector('.origo-accordion__header-btn') as HTMLButtonElement;
+    header?.click();
+    fixture.detectChanges();
+
+    // After expansion, body text should be rendered
+    expect(root.textContent).toContain('Lazy Content Inside');
+  });
