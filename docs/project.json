{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "docs/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx astro build",
        "cwd": "docs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx astro dev",
        "cwd": "docs"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx astro preview",
        "cwd": "docs"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx astro check",
        "cwd": "docs"
      }
    }
  }
}
