{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "importHelpers": true,
    "target": "es2022",
    "module": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@origostudio/design-tokens": ["./packages/design-tokens/src/index.ts"],
      "@origostudio/design-tokens/runtime": ["./packages/design-tokens/src/runtime/index.ts"],
      "@origostudio/angular-renderer": ["./packages/angular-renderer/src/index.ts"],
      "@origostudio/core": ["./packages/core/src/index.ts"],
      "@origostudio/cli": ["./packages/cli/src/index.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp", "dist", ".nx/cache"],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
